+    EXPECT_EQ(index.activePitches(MAX_TIMESTAMP - 1), std::vector<muse::midi::note_idx_t>({ 40, 41, 42 }));
+    EXPECT_EQ(index.activePitches(MAX_TIMESTAMP), std::vector<muse::midi::note_idx_t>({ 40 }));
