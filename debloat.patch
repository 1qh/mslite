-        { stay, cancel }, noBtn, IInteractive::WithIcon)
-    .onResolve(this, [this, yesBtn](const IInteractive::Result& result) {
-        if (result.isButton(yesBtn)) {
-            emit cancelConfirmed();
-        }
-    });
