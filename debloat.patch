+inline PianoKeyLayers resolvePianoKeyLayers(const std::vector<std::vector<piano_key_t> >& layers)
+{
+    PianoKeyLayers keys {};
+    for (size_t layer = 0; layer < layers.size(); ++layer) {
+        applyPianoKeyLayer(keys, layers[layer], layer + 1);
